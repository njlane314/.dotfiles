#!/usr/bin/env bash
set -euo pipefail

image="${1:-$HOME/.config/wallpaper/desktop.webp}"

if [[ "$(uname -s)" != Darwin ]]; then
  printf 'wallpaper applies only to macOS\n' >&2
  exit 0
fi

if [[ ! -f "$image" ]]; then
  printf 'missing wallpaper image: %s\n' "$image" >&2
  exit 1
fi

image="$(cd -- "$(dirname -- "$image")" && pwd)/$(basename -- "$image")"

osascript - "$image" <<'APPLESCRIPT'
on run argv
  set imagePath to item 1 of argv
  tell application "System Events"
    set picture of every desktop to imagePath
  end tell
end run
APPLESCRIPT

printf 'Desktop wallpaper: %s\n' "$image"
