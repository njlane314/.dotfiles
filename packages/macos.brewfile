# Core tools installed by Homebrew Bundle on macOS or Linuxbrew.

brew "git"
brew "gh"
brew "stow"
brew "vim"
brew "tmux"

# search / filesystem
brew "ripgrep"
brew "fd"
brew "fzf"
brew "bat"
brew "eza"

# navigation / shell ergonomics
brew "zoxide"
brew "direnv"

# structured data / HTTP
brew "jq"
brew "yq"
brew "httpie"

# git UX
brew "git-delta"
brew "lazygit"

# monitoring / disk / process
brew "htop"
brew "btop"
brew "bottom"
brew "duf"
brew "dust"
brew "procs"

# dev utility
brew "tokei"
brew "hyperfine"
brew "just"
brew "watchexec"
brew "entr"
brew "sd"
brew "tealdeer"

# language/runtime management
brew "uv"

# editors / language tooling
brew "emacs"
brew "llvm"
brew "cppcheck"
